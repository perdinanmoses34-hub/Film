{
  "entities": {
    "movies": {
      "title": "Movie",
      "description": "Movie metadata item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "synopsis": { "type": "string", "maxLength": 5000 },
        "googleDriveFileId": { "type": "string", "maxLength": 256 },
        "year": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "rating": { "type": "number" },
        "isPremium": { "type": "boolean" },
        "posterUrl": { "type": "string", "maxLength": 1024 },
        "backdropUrl": { "type": "string", "maxLength": 1024 },
        "trailerVideoUrl": { "type": "string", "maxLength": 1024 },
        "resolution": { "type": "string", "maxLength": 32 },
        "director": { "type": "string", "maxLength": 128 },
        "views": { "type": "number" },
        "totalWatchHours": { "type": "number" },
        "releaseDate": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "title", "googleDriveFileId"]
    },
    "reviews": {
      "title": "UserReview",
      "description": "User review for a movie",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "movieId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userAvatar": { "type": "string", "maxLength": 1024 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "date": { "type": "string", "maxLength": 64 },
        "hasSpoiler": { "type": "boolean" },
        "likesCount": { "type": "number" }
      },
      "required": ["id", "movieId", "userId", "userName", "rating", "comment"]
    },
    "users": {
      "title": "UserProfile",
      "description": "User profile state and subscription status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "isVip": { "type": "boolean" },
        "vipTierName": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email"]
    }
  },
  "firestore": {
    "/movies/{movieId}": {
      "schema": "movies",
      "description": "Public catalog of movies and Google Drive media references"
    },
    "/reviews/{reviewId}": {
      "schema": "reviews",
      "description": "Community user reviews on movies"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User personal profiles and preferences"
    }
  }
}
